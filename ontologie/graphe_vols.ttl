    vols:estAnnule false ;
    vols:estDetourne false ;
    vols:estEnRetard false ;
    vols:heureDepartPrevue 9 ;
    vols:idVol "20240101_OO_3779_SEA_09" ;
    vols:numeroVol "3779" ;
    vols:operePar cie:OO ;
    vols:retardArriveeMin -17.0 ;
    vols:retardDepartMin -4.0 ;
