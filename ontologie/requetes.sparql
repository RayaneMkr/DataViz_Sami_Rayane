# =============================================================================
#  Requêtes SPARQL sur le graphe des vols (ontologie/graphe_vols.ttl)
#  Projet DataViz — Sup de Vinci M1 Big Data & IA — Sami & Rayane
# =============================================================================
#  Où les lancer
#    - Fuseki : http://localhost:3030 → dataset « vols » → onglet « query »
#      (après docker compose --profile semantique up -d et notebooks/04_semantique.ipynb)
#    - ou notebooks/04_semantique.ipynb, section 7, qui les lit dans ce fichier et
#      les exécute sur Fuseki, ou sur rdflib si Fuseki n'est pas lancé.
#  Chaque requête déclare ses préfixes : elle se copie-colle seule dans Fuseki.
#
#  Rappel : le graphe contient TOUS les aéroports, compagnies et États, mais
#  seulement les 50 routes prioritaires et un échantillon de 500 vols sur ces
#  routes. Les chiffres par vol (Q1, Q3) illustrent la méthode ; les taux
#  nationaux font foi dans les tables gold.
# =============================================================================


# =============================================================================
# Q1 — Part des minutes de retard contrôlables, par hub de départ
# =============================================================================
#  Question du persona : au départ de quels hubs les retards sont-ils surtout de
#  notre fait (donc réductibles) plutôt que dus à la météo ou au contrôle aérien ?
#
#  Ce que la requête exploite de l'ontologie
#    1. la hiérarchie des aéroports : « ?aeroport a/rdfs:subClassOf* vols:Hub »
#       accepte vols:Hub et toute sous-classe qu'on lui ajouterait ;
#    2. la hiérarchie des causes : une cause est contrôlable si son type est,
#       directement ou non, une sous-classe de vols:CauseControlable. Aucune
#       liste de causes n'est écrite dans la requête ;
#    3. les imputations (vol × cause × minutes) : les cinq causes sont des
#       nœuds, pas cinq colonnes, donc une seule ligne de motif les couvre.
#
#  Lecture : part_controlable_pct = minutes dues à la compagnie ou à l'avion en
#  retard / toutes les minutes de retard des vols partis du hub. On écarte les
#  hubs avec moins de 3 vols en retard dans l'échantillon (part trop instable).
#
#  Pourquoi ce serait plus lourd en SQL — la même question sur un schéma
#  relationnel (tables vols, aeroports, une colonne par cause) :
#
#    WITH RECURSIVE controlables(classe) AS (       -- (a) descendre la hiérarchie
#        SELECT 'CauseControlable'
#        UNION ALL
#        SELECT h.classe FROM hierarchie_causes h
#        JOIN controlables c ON h.classe_mere = c.classe
#    ),
#    imputations AS (                               -- (b) dépivoter les 5 colonnes
#        SELECT id_vol, origine, 'compagnie' AS cause, retard_compagnie_min AS minutes FROM vols
#        UNION ALL SELECT id_vol, origine, 'avion_retard', retard_avion_min    FROM vols
#        UNION ALL SELECT id_vol, origine, 'meteo',        retard_meteo_min    FROM vols
#        UNION ALL SELECT id_vol, origine, 'nas',          retard_nas_min      FROM vols
#        UNION ALL SELECT id_vol, origine, 'securite',     retard_securite_min FROM vols
#    )
#    SELECT a.code_iata, a.ville,
#           COUNT(DISTINCT i.id_vol) AS vols_en_retard,
#           ROUND(SUM(i.minutes))    AS minutes_retard,
#           ROUND(100.0 * SUM(CASE WHEN c.classe IN (SELECT classe FROM controlables)
#                                  THEN i.minutes ELSE 0 END) / SUM(i.minutes), 1) AS part_controlable_pct
#    FROM imputations i
#    JOIN aeroports a     ON a.code_iata = i.origine AND a.est_hub   -- (c) « est un hub » = un booléen
#    JOIN causes_classe c ON c.cause = i.cause                       -- (d) table cause → classe
#    WHERE i.minutes > 0
#    GROUP BY a.code_iata, a.ville
#    HAVING COUNT(DISTINCT i.id_vol) >= 3
#    ORDER BY part_controlable_pct DESC;
#
#    (a) SQL ne connaît pas la notion de sous-classe : il faut une table de
#        hiérarchie et un WITH RECURSIVE pour la parcourir à toute profondeur.
#        En SPARQL, c'est le chemin « rdfs:subClassOf* ».
#    (b) Les causes sont des colonnes : il faut cinq SELECT recollés par UNION ALL
#        avant de pouvoir grouper. Ajouter une sixième cause oblige à modifier le
#        schéma de la table ET chaque requête ; dans le graphe, c'est un individu
#        de plus, et cette requête ne change pas.
#    (c) « Hub » est une colonne booléenne à tenir à jour à côté du type ; dans le
#        graphe, c'est le type lui-même, et un hub reste un aéroport pour toutes
#        les requêtes sur vols:Aeroport.
#    (d) La classification contrôlable / non contrôlable est une donnée de plus à
#        joindre (ou, comme dans gold_causes_retard, une colonne recopiée sur
#        chaque ligne : la changer oblige à recalculer la table). Ici, elle est
#        écrite une seule fois dans l'ontologie : reclasser une cause, c'est
#        changer un triplet dans vols.ttl.

PREFIX vols: <http://example.org/vols/ontologie#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?hub ?ville
       (COUNT(DISTINCT ?vol) AS ?vols_en_retard)
       (ROUND(SUM(?minutes)) AS ?minutes_retard)
       (ROUND(1000 * SUM(IF(?controlable, ?minutes, 0)) / SUM(?minutes)) / 10 AS ?part_controlable_pct)
WHERE {
    ?aeroport a/rdfs:subClassOf* vols:Hub ;
              vols:codeIATA ?hub ;
              vols:ville ?ville .
    ?vol vols:aeroportDepart ?aeroport ;
         vols:aImputation ?imputation .
    ?imputation vols:cause ?cause ;
                vols:minutes ?minutes .
    BIND (EXISTS { ?cause a/rdfs:subClassOf* vols:CauseControlable } AS ?controlable)
}
GROUP BY ?hub ?ville
HAVING (COUNT(DISTINCT ?vol) >= 3)
ORDER BY DESC(?part_controlable_pct) ?hub
